# Quote/0 (ESP32-C3) — 章鱼AI.每日占一占 固件默认配置

# 控制台必须用 Pure USB Serial/JTAG（UART 引脚与显示电源 GPIO20 冲突）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

# 分区表: factory 应用区 1.875MB（含 16px 中文字库）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_zhangyu.csv"

# 体积优化 + 4MB Flash
CONFIG_COMPILER_OPTIMIZATION_RELEASE=y
CONFIG_ESPTOOL_FLASH_SIZE_4MB=y

# HTTPS 证书束（拉取占星接口用）
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# 日志
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 主任务栈（HTTP + TLS + cJSON + 渲染）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
